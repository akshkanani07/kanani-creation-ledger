# ============================================================
# KANANI CREATION LEDGER — ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.
# ============================================================

# ---------- Node Environment ----------
NODE_ENV=development

# ---------- Database (Neon PostgreSQL) ----------
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require

# ---------- Better Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-minimum-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# ---------- Mailjet ----------
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=noreply@example.com
MAILJET_FROM_NAME=Kanani Creation

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kanani_creation_karigars

# ---------- Owner ----------
OWNER_EMAIL=owner@example.com

# ---------- Public ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000